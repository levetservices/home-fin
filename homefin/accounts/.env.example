# Where Jellyfin is, from this service's point of view.
JELLYFIN_URL=http://jellyfin:8096
# Jellyfin Dashboard → API Keys → + (name it "Home Fin")
JELLYFIN_API_KEY=
# 32 random bytes: openssl rand -base64 32   (keep it safe — it encrypts profile passwords)
HOMEFIN_SECRET=
# Your first admin account (only used when there are no accounts yet).
HOMEFIN_ADMIN_EMAIL=you@example.com
HOMEFIN_ADMIN_PASSWORD=
# Public address people use, e.g. https://tv.example.com (turns on Secure cookies for https).
HOMEFIN_PUBLIC_URL=
HOMEFIN_SERVER_NAME=Home Fin
# true = this service is the front door and proxies everything else to Jellyfin.
PROXY_JELLYFIN=true
PORT=8097
